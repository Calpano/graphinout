<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.graphinout</groupId>
        <artifactId>graphinout</artifactId>
        <version>0.2.5</version>
    </parent>

    <artifactId>reader-rdf</artifactId>
    <name>reader-rdf</name>
    <description>Reader for RDF (Resource Description Framework)</description>

    <dependencies>
        <!-- Main Dependencies -->
        <dependency><groupId>org.jspecify</groupId><artifactId>jspecify</artifactId></dependency>
        <dependency><groupId>com.graphinout</groupId><artifactId>base</artifactId></dependency>
        <!-- fetches remote JSON-LD contexts from public addresses only -->
        <dependency><groupId>com.graphinout</groupId><artifactId>base-http</artifactId></dependency>
        <dependency><groupId>org.apache.jena</groupId><artifactId>jena-core</artifactId><version>6.2.0</version></dependency>
        <dependency><groupId>org.apache.jena</groupId><artifactId>jena-arq</artifactId><version>6.2.0</version></dependency>
        <!-- JSON-LD processor used by Jena; we plug in our allowlisting document loader. Version as managed by Jena 6.2.0. -->
        <dependency><groupId>com.apicatalog</groupId><artifactId>titanium-json-ld</artifactId><version>1.7.0</version></dependency>
        <dependency><groupId>com.graphinout</groupId><artifactId>foundation-pure</artifactId></dependency>
        <dependency><groupId>com.graphinout</groupId><artifactId>base-api</artifactId></dependency>
        <dependency><groupId>org.slf4j</groupId><artifactId>slf4j-api</artifactId></dependency>

        <!-- Test Dependencies -->
        <dependency><groupId>com.graphinout</groupId><artifactId>testdata</artifactId><scope>test</scope></dependency>
        <dependency><groupId>com.graphinout</groupId><artifactId>base</artifactId>
            <classifier>tests</classifier><type>test-jar</type><scope>test</scope>
        </dependency>
        <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
        <dependency><groupId>io.github.classgraph</groupId><artifactId>classgraph</artifactId><scope>test</scope></dependency>
        <dependency><groupId>com.google.truth</groupId><artifactId>truth</artifactId><scope>test</scope></dependency>
    </dependencies>
</project>
