<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <artifactId>graphinout</artifactId>
        <groupId>com.graphinout</groupId>
        <version>0.2.6-SNAPSHOT</version>
    </parent>

    <artifactId>foundation-pure</artifactId>
    <name>foundation-pure</name>
    <description>
        Foundation is in general a dependency-free base layer for Java projects.
        Foundation has four layers: 'emulation', 'pure', 'shared', 'jvm'.
        ⚪️Emulation: Stripped down annotations (jspecify, Jackson). For j2cl-compiler. Java 8 syntax and JRE.
        ⚪️Pure: No dependencies (except on 'emulation'), only classes from the j2cl compatible fragment. Java 8 syntax.
        ⚪️Shared: Only j2cl-dependencies allowed (e.g. gwt-regexp). Java 8 syntax and JRE.
        ⚪️JVM: This code cannot j2cl-compile. Any java syntax.
        See foundation-pure/README.adoc for details.
    </description>

    <properties>
        <!-- current j2cl version is Java 8 syntax. See j2cl.adoc -->
        <maven.compiler.source>8</maven.compiler.source>
        <maven.compiler.target>8</maven.compiler.target>
        <maven.compiler.release>8</maven.compiler.release>
    </properties>

    <dependencies>
        <!-- jspecify + Jackson annotations come from foundation-emulation (j2cl-compatible copies).
             Do not add org.jspecify:jspecify here: it is Java 9+ (ElementType.MODULE) and would shadow the copies.
             JVM consumers exclude foundation-emulation and add the real artifacts (see foundation-jvm). -->
        <dependency><groupId>com.graphinout</groupId><artifactId>foundation-emulation</artifactId></dependency>

        <!-- Test Dependencies -->
        <dependency><groupId>com.graphinout</groupId><artifactId>testdata</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.slf4j</groupId><artifactId>slf4j-api</artifactId><scope>test</scope></dependency>
        <dependency><groupId>ch.qos.logback</groupId><artifactId>logback-classic</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
        <dependency><groupId>com.google.truth</groupId><artifactId>truth</artifactId><scope>test</scope></dependency>
        <dependency><groupId>tools.jackson.core</groupId><artifactId>jackson-databind</artifactId><scope>test</scope></dependency>
        <dependency><groupId>io.github.classgraph</groupId><artifactId>classgraph</artifactId><scope>test</scope></dependency>
        <dependency><groupId>tools.jackson.core</groupId><artifactId>jackson-core</artifactId><scope>test</scope></dependency>
    </dependencies>

    <build>
        <resources>
            <!-- bundle sources with the main jar, so they are visible to j2cl -->
            <resource>
                <directory>src/main/java</directory>
                <includes>
                    <include>**/*.java</include>
                </includes>
                <filtering>false</filtering>
            </resource>
            <!-- keep default resources -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
            </resource>
            <!-- these <resources> replace the parent's: repeat its LICENSE entry (ships META-INF/LICENSE;
                 the parent stages the root LICENSE into target/license/META-INF/) -->
            <resource>
                <directory>${project.build.directory}/license</directory>
                <filtering>false</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- to use JDK 24 or 25 with Mockito -->
                    <argLine>-Dnet.bytebuddy.experimental=true</argLine>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId><artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>${j2cl-mp-group}</groupId><artifactId>${j2cl-mp-artifact}</artifactId>
                <version>${j2cl-mp-version}</version>
                <executions><execution>
                    <phase>compile</phase>
                    <goals><goal>build</goal></goals>
                </execution></executions>
                <configuration>
                    <webappDirectory>${project.basedir}/target/webapp</webappDirectory>
                    <initialScriptFilename>j2cl-result.js</initialScriptFilename>
                    <enableSourcemaps>${j2cl-mp-enableSourceMaps}</enableSourcemaps>
                    <compilationLevel>${j2cl-mp-compilationLevel}</compilationLevel>
                </configuration>
            </plugin>

        </plugins>
    </build>

</project>
