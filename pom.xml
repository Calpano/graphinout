    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <slf4j-version>2.0.17</slf4j-version>
        <!-- logback: taken from origin/main (dependabot patch bump 1.5.33 -> 1.5.34) -->
        <logback-classic-version>1.5.34</logback-classic-version>
        <junit-jupiter.version>5.9.2</junit-jupiter.version>
        <!--
            Mockito's inline mock maker rewrites classes through Byte Buddy, so it has to understand the
            running JVM's class file version. 5.6.0 (Byte Buddy 1.14.x) cannot, and on JDK 26 every test
            with an @Mock died in @BeforeEach with
              MockitoException: Could not modify all classes [...]
            — 280 errors in reader-ddot alone, which read as a broken build rather than an unsupported JDK.
            Keep these two in lockstep, and expect to bump them again for each new JDK.
        -->
        <mockito-core-version>5.20.0</mockito-core-version>
        <mockito-junit-jupiter-version>5.20.0</mockito-junit-jupiter-version>
        <maven-surefire-plugin.version>3.0.0-M7</maven-surefire-plugin.version>
        <!--
            NOTE ON THE MERGE FROM main: dependabot bumped this property to 2.21.5 there, and that bump is
            deliberately NOT taken. On main the property still named a com.fasterxml.jackson.core (Jackson 2)
            artifact; on this line it was repurposed by the Jackson 3 migration and now drives
            tools.jackson.core:jackson-core / :jackson-databind below. There is no tools.jackson 2.21.5, so
            accepting the bump would point Jackson 3 coordinates at a version that does not exist.
            Jackson 2 artifacts are pinned separately by jackson-annotations-version.
        -->
        <jackson-core-version>3.2.1</jackson-core-version>
        <jackson-databind-version>3.2.0</jackson-databind-version>
        <jackson-annotations-version>2.21</jackson-annotations-version>

        <j2cl-mp-version>0.22.0</j2cl-mp-version>
        <j2cl-mp-group>com.vertispan.j2cl</j2cl-mp-group>
        <j2cl-mp-artifact>j2cl-maven-plugin</j2cl-mp-artifact>
        <j2cl-mp-enableSourceMaps>true</j2cl-mp-enableSourceMaps>
        <j2cl-mp-compilationLevel>ADVANCED</j2cl-mp-compilationLevel>
    </properties>

