    <build>
        <!-- Ship the BSD-3-Clause LICENSE inside every jar as META-INF/LICENSE: clause 2 requires binary
             redistributions to reproduce it, and META-INF is where tools and users look for it.
             The root LICENSE is first staged into target/license/META-INF/ (see maven-resources-plugin below), and
             that staging dir is the resource dir. Not the reactor root itself: the j2cl plugin (foundation-emulation,
             foundation-pure) compiles every resource dir as a source root and ignores <includes>, so the root would
             pull in all modules' Java sources; IDEs would also import the root as a resource folder of every module.
             foundation-emulation/-pure/-shared declare their own <resources> (which replace these): keep them in sync. -->
        <resources>
            <!-- keep the default resources: declaring <resources> replaces them -->
            <resource><directory>src/main/resources</directory></resource>
            <resource><directory>${project.build.directory}/license</directory></resource>
        </resources>
        <testResources>
            <!-- keep the default test resources: declaring <testResources> replaces them -->
            <testResource><directory>src/test/resources</directory></testResource>
            <testResource><directory>${project.build.directory}/license</directory></testResource>
        </testResources>
        <plugins>
            <plugin>
                <!-- commons-io was replaced by plain JDK IO; no module may declare it again (see commons-io-removal.adoc) -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.6.2</version>
                <executions>
                    <execution>
                        <id>ban-commons-io</id>
                        <goals><goal>enforce</goal></goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <excludes><exclude>commons-io:commons-io</exclude></excludes>
                                    <!-- direct only: Jena (jena-base, commons-csv) still needs it at runtime -->
                                    <searchTransitive>false</searchTransitive>
                                    <message>commons-io was removed on purpose; use JDK IO (see commons-io-removal.adoc).</message>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <!-- Stage the root LICENSE for the <resources> above (main, sources and tests jars).
                             In a module, ${project.basedir} is the module dir; maven.multiModuleProjectDirectory is
                             the reactor root (anchored by the .mvn/ dir). -->
                        <id>stage-license</id>
                        <phase>generate-resources</phase>
                        <goals><goal>copy-resources</goal></goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/license/META-INF</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${maven.multiModuleProjectDirectory}</directory>
                                    <includes><include>LICENSE</include></includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                    <execution>
                        <!-- The javadoc jar ignores <resources>: copy LICENSE into the javadoc output before it is
                             jarred. maven-javadoc-plugin 3.12.0 jars target/reports/apidocs (NOT target/apidocs);
                             recheck this path after upgrading the javadoc plugin. -->
                        <id>license-into-javadoc</id>
                        <phase>prepare-package</phase>
                        <goals><goal>copy-resources</goal></goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/reports/apidocs/META-INF</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${maven.multiModuleProjectDirectory}</directory>
                                    <includes><include>LICENSE</include></includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.16.0</version>
                <configuration>
                    <source>25</source>
                    <target>25</target>
                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven-surefire-plugin.version}</version>
                <configuration>
                    <argLine>-XX:+EnableDynamicAgentLoading -Xshare:off</argLine>
                    <!-- One shared test-logging config for every module, loaded by file path (not the classpath) so
                         there is never a duplicate logback-test.xml on any classpath and nothing leaks through
                         test-jars. maven.multiModuleProjectDirectory is the reactor root (anchored by the .mvn/ dir). -->
                    <systemPropertyVariables>
                        <logback.configurationFile>${maven.multiModuleProjectDirectory}/config/logback-test.xml</logback.configurationFile>
                    </systemPropertyVariables>
                </configuration>
                <executions>
                    <execution>
                        <id>default-test</id>
                        <phase>test</phase>
                        <goals>
                            <goal>test</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                        <configuration>
                            <!-- A test-jar shares reusable test CODE (e.g. ReaderTests), not logging config: test
                                 logging uses one shared file via -Dlogback.configurationFile (see the surefire plugin
                                 above). Excluding logback config from test-jars is a belt-and-braces guard so a stray
                                 one can never leak onto a dependent's classpath. -->
                            <excludes>
                                <exclude>logback-test.xml</exclude>
                                <exclude>logback.xml</exclude>
                            </excludes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <!-- Publish self-contained POMs. The Central Portal validates each POM standalone (it does not
                     resolve the parent), so flatten inlines parent-managed dependency versions and the required
                     project metadata (url/scm/licenses/developers/description) and drops test-scope deps. -->
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>1.9.0</version>
                <configuration>
                    <flattenMode>ossrh</flattenMode>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals><goal>flatten</goal></goals>
                    </execution>
                    <execution>
                        <id>flatten-clean</id>
                        <phase>clean</phase>
                        <goals><goal>clean</goal></goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <!-- create "-sources.jar" at verify-phase just before install-phase -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.4.0</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
              <groupId>org.apache.maven.plugins</groupId>
              <artifactId>maven-javadoc-plugin</artifactId>
              <version>3.12.0</version>
              <configuration>
                <!-- Relax doclint to allow generation even with minor HTML issues while we improve source Javadoc -->
                <failOnError>false</failOnError>
                <doclint>none</doclint>
                <!-- Ensure consistent language to avoid locale-specific doclint behavior -->
                <locale>en</locale>
                <!-- JDK 23+ copies the DejaVu web fonts (~3.5 MB) into every javadoc jar: 128 MB over all modules,
                     and the Central upload of that bundle broke off ("Broken pipe"). Browsers fall back to system fonts. -->
                <additionalOptions>--no-fonts</additionalOptions>
              </configuration>
              <executions>
                <execution>
                  <id>attach-javadocs</id>
                  <goals>
                    <goal>jar</goal>
                  </goals>
                </execution>
              </executions>
            </plugin>

            <!-- 0.12.0: under Maven 3.10, 0.9.0 put maven-metadata-local.xml and _remote.repositories into the bundle,
                 and Central rejected it ("Bundle has content that does NOT have a .pom file"). -->
            <plugin>
                  <groupId>org.sonatype.central</groupId>
                  <artifactId>central-publishing-maven-plugin</artifactId>
                  <version>0.12.0</version>
                  <extensions>true</extensions>
                  <configuration>
                    <publishingServerId>central</publishingServerId>
                    <!-- Only MD5 + SHA1 (Central's required set); skips the optional .sha256/.sha512 sidecars to
                         cut ~2 files per published artifact. -->
                    <checksums>required</checksums>
                    <!-- 'cli' is an application (it attaches a ~52 MB shaded uber-jar), not a library: keep the whole
                         cli coordinate out of Central. excludeArtifacts matches by artifactId, so this drops the
                         cli main jar, the -cli shaded uber-jar, sources and pom. cli is still built locally (the
                         `gio` launcher uses cli/target/cli-*-cli.jar); nothing published depends on cli. -->
                    <excludeArtifacts>
                      <excludeArtifact>cli</excludeArtifact>
                      <!-- devtools is internal dev/build tooling, never a published library -->
                      <excludeArtifact>devtools</excludeArtifact>
                    </excludeArtifacts>
                  </configuration>
            </plugin>

        </plugins>
    </build>

    <distributionManagement>
        <snapshotRepository>
            <id>github-graphinout</id>
            <name>GitHub Graphinout Maven Packages</name>
            <url>https://maven.pkg.github.com/Calpano/graphinout</url>
        </snapshotRepository>
    </distributionManagement>

<profiles>
    <profile>
      <id>sign-for-sonar</id>
      <activation>
        <property><name>performRelease</name><value>true</value></property>
        <activeByDefault>false</activeByDefault>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.2.8</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals>
                  <goal>sign</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <!-- Publish a -SNAPSHOT to Maven Central's snapshot repository instead of GitHub Packages (the default
           snapshotRepository, which CI deploys to on every push to main). The central-publishing plugin uploads
           snapshots to https://central.sonatype.com/repository/maven-snapshots/ with the 'central' credentials,
           but reads the existing snapshot metadata through the snapshotRepository below.
           Usage: mvn deploy -P central-deploy,sign-for-sonar,central-snapshots (see how-to-release.adoc) -->
      <id>central-snapshots</id>
      <distributionManagement>
        <snapshotRepository>
          <id>central</id>
          <name>Maven Central snapshots</name>
          <url>https://central.sonatype.com/repository/maven-snapshots/</url>
        </snapshotRepository>
      </distributionManagement>
    </profile>
</profiles>

</project>
