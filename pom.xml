    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.0</version>
                <configuration>
                    <source>21</source>
                    <target>21</target>
                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven-surefire-plugin.version}</version>
                <configuration>
                    <argLine>-XX:+EnableDynamicAgentLoading -Xshare:off</argLine>
                    <!-- One shared test-logging config for every module, loaded by file path (not the classpath) so
                         there is never a duplicate logback-test.xml on any classpath and nothing leaks through
                         test-jars. maven.multiModuleProjectDirectory is the reactor root (anchored by the .mvn/ dir). -->
                    <systemPropertyVariables>
                        <logback.configurationFile>${maven.multiModuleProjectDirectory}/config/logback-test.xml</logback.configurationFile>
                    </systemPropertyVariables>
                </configuration>
                <executions>
                    <execution>
                        <id>default-test</id>
                        <phase>test</phase>
                        <goals>
                            <goal>test</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.1</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                        <configuration>
                            <!-- A test-jar shares reusable test CODE (e.g. ReaderTests), not logging config: test
                                 logging uses one shared file via -Dlogback.configurationFile (see the surefire plugin
                                 above). Excluding logback config from test-jars is a belt-and-braces guard so a stray
                                 one can never leak onto a dependent's classpath. -->
                            <excludes>
                                <exclude>logback-test.xml</exclude>
                                <exclude>logback.xml</exclude>
                            </excludes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <!-- Publish self-contained POMs. The Central Portal validates each POM standalone (it does not
                     resolve the parent), so flatten inlines parent-managed dependency versions and the required
                     project metadata (url/scm/licenses/developers/description) and drops test-scope deps. -->
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>1.6.0</version>
                <configuration>
                    <flattenMode>ossrh</flattenMode>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals><goal>flatten</goal></goals>
                    </execution>
                    <execution>
                        <id>flatten-clean</id>
                        <phase>clean</phase>
                        <goals><goal>clean</goal></goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <!-- create "-sources.jar" at verify-phase just before install-phase -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
              <groupId>org.apache.maven.plugins</groupId>
              <artifactId>maven-javadoc-plugin</artifactId>
              <version>3.11.2</version>
              <configuration>
                <!-- Relax doclint to allow generation even with minor HTML issues while we improve source Javadoc -->
                <failOnError>false</failOnError>
                <doclint>none</doclint>
                <!-- Ensure consistent language to avoid locale-specific doclint behavior -->
                <locale>en</locale>
              </configuration>
              <executions>
                <execution>
                  <id>attach-javadocs</id>
                  <goals>
                    <goal>jar</goal>
                  </goals>
                </execution>
              </executions>
            </plugin>

            <plugin>
                  <groupId>org.sonatype.central</groupId>
                  <artifactId>central-publishing-maven-plugin</artifactId>
                  <version>0.9.0</version>
                  <extensions>true</extensions>
                  <configuration>
                    <publishingServerId>central</publishingServerId>
                    <!-- Only MD5 + SHA1 (Central's required set); skips the optional .sha256/.sha512 sidecars to
                         cut ~2 files per published artifact. -->
                    <checksums>required</checksums>
                    <!-- 'cli' is an application (it attaches a ~52 MB shaded uber-jar), not a library: keep the whole
                         cli coordinate out of Central. excludeArtifacts matches by artifactId, so this drops the
                         cli main jar, the -cli shaded uber-jar, sources and pom. cli is still built locally (the
                         `gio` launcher uses cli/target/cli-*-cli.jar); nothing published depends on cli. -->
                    <excludeArtifacts>
                      <excludeArtifact>cli</excludeArtifact>
                      <!-- devtools is internal dev/build tooling, never a published library -->
                      <excludeArtifact>devtools</excludeArtifact>
                    </excludeArtifacts>
                  </configuration>
            </plugin>

        </plugins>
    </build>

    <distributionManagement>
        <snapshotRepository>
            <id>github-graphinout</id>
            <name>GitHub Graphinout Maven Packages</name>
            <url>https://maven.pkg.github.com/Calpano/graphinout</url>
        </snapshotRepository>
    </distributionManagement>

<profiles>
    <profile>
      <id>sign-for-sonar</id>
      <activation>
        <property><name>performRelease</name><value>true</value></property>
        <activeByDefault>false</activeByDefault>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.2.8</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals>
                  <goal>sign</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
</profiles>

