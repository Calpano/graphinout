<?xml version="1.0" encoding="UTF-8"?>
<!-- CLI logging: keep stdout clean for converted output; send WARN+ diagnostics to stderr.
     Override the level with -Dlogback.configurationFile=... or by raising the root level. -->
<configuration>
    <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.err</target>
        <encoder>
            <pattern>%-5level %logger{0} - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="WARN">
        <appender-ref ref="STDERR"/>
    </root>
</configuration>
