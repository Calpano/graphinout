<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.graphinout</groupId>
        <artifactId>graphinout</artifactId>
        <version>0.2.2-SNAPSHOT</version>
    </parent>

    <artifactId>reader-ddot</artifactId>
    <name>reader-ddot</name>
    <description>Reader for DDot.it simple triple text format (S .. P .. O).</description>

    <dependencies>
        <!-- Main Dependencies -->
        <dependency><groupId>org.jspecify</groupId><artifactId>jspecify</artifactId></dependency>
        <!--
          The ddot.it grammar itself: tokenizer + triple-event exporter, pinned to the cross-implementation
          golden corpus. Deliberately zero-dependency (jspecify only), which is what makes it consumable
          here: reader-ddot depends on com.graphinout:base, so a ddot-core that depended on graphinout
          would close a build cycle. See ddot-core's pom for the enforcer rules that keep it that way.
        -->
        <dependency><groupId>com.calpano.ddot.it</groupId><artifactId>ddot-core</artifactId><version>0.1.1</version></dependency>
        <dependency><groupId>com.graphinout</groupId><artifactId>base</artifactId></dependency>
        <dependency><groupId>commons-io</groupId><artifactId>commons-io</artifactId></dependency>

        <!-- Test Dependencies -->
        <dependency><groupId>com.graphinout</groupId><artifactId>testdata</artifactId><scope>test</scope></dependency>
        <dependency><groupId>com.graphinout</groupId><artifactId>testdata</artifactId>
            <classifier>tests</classifier><type>test-jar</type><scope>test</scope>
        </dependency>
        <dependency><groupId>com.graphinout</groupId><artifactId>base</artifactId>
            <classifier>tests</classifier><type>test-jar</type><scope>test</scope>
        </dependency>
        <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
        <dependency><groupId>io.github.classgraph</groupId><artifactId>classgraph</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.mockito</groupId><artifactId>mockito-junit-jupiter</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.mockito</groupId><artifactId>mockito-core</artifactId><scope>test</scope></dependency>
        <dependency><groupId>com.google.truth</groupId><artifactId>truth</artifactId><scope>test</scope></dependency>
    </dependencies>
</project>
