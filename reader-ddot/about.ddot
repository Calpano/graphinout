# Formats read/written by the GraphInOut DDot reader.
# Object ids reference the graph-format-registry (https://github.com/calpano/graph-format-registry).
# 'ddot' (ddot.it triple text) is not yet a registered format id.

graphinout-reader-ddot ..has type.. tool
graphinout-reader-ddot ..label.. GraphInOut DDot Reader
graphinout-reader-ddot ..reads.. ddot
graphinout-reader-ddot ..writes.. ddot



com.graphinoutit:reader-ddot ..has type.. Adir Project
..uses.. it.ddot:ddotit-core
..uses..com.graphinoutit:base
